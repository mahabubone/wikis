---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Wikis by @mahabubone — API docs, system design, debugging, principles, and engineering notes.",
  canonical,
  ogImage = "/og.png",
  noindex = false,
} = Astro.props;

const site = Astro.site?.toString() ?? "https://mahabubone.github.io/wikis";
const canonicalURL = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogURL = ogImage.startsWith("http") ? ogImage : new URL(ogImage, site).toString();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogURL} />
    <meta property="og:site_name" content="Wikis by @mahabubone" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogURL} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <meta name="theme-color" content="#18181b" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
    <script is:inline>
      // Minimal: respect prefers-color-scheme is automatic via CSS; placeholder for future dark toggle
    </script>
  </body>
</html>
