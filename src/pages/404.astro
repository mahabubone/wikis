---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="404 — Not found" description="Page not found" noindex>
  <Header />
  <main class="mx-auto max-w-2xl px-6 py-16 text-center">
    <p class="text-sm font-semibold tracking-widest text-zinc-400 uppercase">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-3 text-zinc-600">The wiki you’re looking for doesn’t exist. Check the sidebar or go back home.</p>
    <div class="mt-6 flex justify-center gap-3">
      <a href={`${base}`} class="rounded-full bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800">Go home</a>
      <a href={`${base}apis/`} class="rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-medium">Browse APIs</a>
    </div>
  </main>
</Layout>
