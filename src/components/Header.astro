---
const base = import.meta.env.BASE_URL;
const SUPPORTKORI_URL = "https://www.supportkori.com/mahabubone";
const GH_REPO_URL = "https://github.com/mahabubone/wikis";
---

<header class="sticky top-0 z-40 w-full border-b border-zinc-200 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70">
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between gap-4">
      <a href={`${base}`} class="flex items-center gap-2.5 shrink-0">
        <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-zinc-900 text-white text-[11px] font-bold tracking-widest">W</span>
        <span class="font-semibold tracking-tight">Wikis for Devs</span>
      </a>

      <div class="flex items-center gap-2">
        <button
          id="mobile-nav-toggle"
          class="inline-flex lg:hidden h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-50 active:bg-zinc-100"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="mobile-sidebar"
          type="button"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <a
          href={SUPPORTKORI_URL}
          target="_blank"
          rel="noopener"
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-pink-700 bg-pink-50 border border-pink-200 px-3 py-1.5 rounded-full hover:bg-pink-100 transition"
          title="Support on SupportKori — https://www.supportkori.com/mahabubone"
        >
          <span class="h-2 w-2 rounded-full bg-pink-500 animate-pulse"></span>
          Tip me :)
        </a>
        <a
          href={GH_REPO_URL}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 text-xs text-zinc-600 hover:text-zinc-900 px-2.5 py-1.5 rounded-full border border-zinc-200 bg-white hover:bg-zinc-50 transition"
          title="GitHub repo — mahabubone/wikis"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M12 2.04c-5.5 0-9.96 4.46-9.96 9.96 0 4.41 2.87 8.14 6.84 9.46.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.45-1.11-1.45-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.35 1.08 2.92.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02.8-.22 1.66-.33 2.5-.33.85 0 1.71.11 2.51.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .26.18.58.69.48A10.01 10.01 0 0 0 22 12.04C22 6.54 17.5 2.04 12 2.04z"/></svg>
          <span class="hidden sm:inline">GitHub</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden sm:inline"><path d="M7 17L17 7" /><path d="M8 7h9v9" /></svg>
        </a>
      </div>
    </div>
  </div>
</header>
